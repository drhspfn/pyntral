# Generate a hash: uv run pyntral hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-scrypt-hash
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
APP_SECRET_KEY=replace-with-48-random-chars
# LOCAL HTTP ONLY (set true in production HTTPS):
ADMIN_SECURE_COOKIE=false
DATABASE_URL=sqlite:///./shop.db
